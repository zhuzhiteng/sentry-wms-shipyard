<view class="page login-page">
  <view class="hero">
    <view class="chip">现场作业</view>
    <view class="hero-title">船厂仓储现场作业</view>
    <view class="hero-meta">到货收货、出库、吊牌拍照和装车确认</view>
  </view>

  <view class="card login-card">
    <view class="title">账号登录</view>
    <view class="subtitle">请输入管理员分配的员工账号和密码。</view>
    <view class="field">
      <view class="label">账号</view>
      <input
        class="input"
        value="{{username}}"
        placeholder="员工账号"
        bindinput="onUsernameInput"
      />
    </view>
    <view class="field">
      <view class="label">密码</view>
      <input
        class="input"
        password
        value="{{password}}"
        placeholder="登录密码"
        bindinput="onPasswordInput"
        bindconfirm="login"
      />
    </view>
    <button class="button-primary" loading="{{busy}}" disabled="{{busy}}" bindtap="login">
      登录
    </button>
  </view>
</view>
