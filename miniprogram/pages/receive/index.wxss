.manifest-metrics {
  margin-top: 24rpx;
}

.pallet-progress {
  margin-top: 16rpx;
  color: #4d6476;
  font-size: 24rpx;
  font-weight: 600;
}

.workbench-metrics {
  margin-top: 18rpx;
}

.quantity-hint {
  margin-top: 8rpx;
  line-height: 1.5;
}

.quantity-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  background: #eef5f9;
}

.quantity-value {
  margin-top: 4rpx;
  color: #174b70;
  font-size: 42rpx;
  font-weight: 700;
}

.quantity-edit {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 18rpx;
  min-height: 88rpx;
  border-radius: 10rpx;
  color: #80520d;
  background: #fff3d9;
  font-size: 23rpx;
  line-height: 88rpx;
}

.quantity-edit::after {
  border: 0;
}

.quantity-edit-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.quantity-reset {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 18rpx;
  min-height: 88rpx;
  border-radius: 10rpx;
  color: #1f5d89;
  background: #e8f0f5;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.quantity-reset::after {
  border: 0;
}

.arrival-slip-summary {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  color: #314b5f;
  background: #f3f7f9;
  font-size: 24rpx;
}

.arrival-slip-summary .muted {
  display: inline-block;
  min-width: 130rpx;
  color: #5f7080;
}

.arrival-slip-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  min-height: 88rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  color: #1f5d89;
  background: #f1f5f8;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}

.time {
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.45;
}

.area {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  background: #eef5f9;
}

.area-value {
  margin-top: 6rpx;
  color: #174b70;
  font-size: 32rpx;
  font-weight: 700;
}

.workbench {
  border-color: #32749d;
}

.next-suffix {
  margin-top: 18rpx;
  color: #215c83;
  font-weight: 700;
  text-align: center;
}

.scans {
  margin-top: 20rpx;
  border-top: 1rpx solid #e8edf1;
}

.scan-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e8edf1;
}

.scan-main {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
  gap: 16rpx;
}

.scan-photo {
  flex: 0 0 104rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 10rpx;
  background: #eef5f9;
}

.scan-info {
  min-width: 0;
}

.scan-hint {
  margin-top: 4rpx;
  color: #29704f;
  font-size: 21rpx;
}

.mini-action {
  margin: 0;
  padding: 0 16rpx;
  min-height: 88rpx;
  color: #8a3030;
  background: #fbeaea;
  border-radius: 10rpx;
  font-size: 22rpx;
  line-height: 88rpx;
}

.mini-action::after {
  border: 0;
}

.ocr-note {
  margin-top: 12rpx;
  color: #647684;
  font-size: 22rpx;
  line-height: 1.5;
}

.uncertain-banner {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-left: 6rpx solid #b26a20;
  border-radius: 10rpx;
  color: #73420d;
  background: #fff4e5;
  font-size: 23rpx;
  line-height: 1.55;
}
