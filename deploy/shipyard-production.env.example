# Copy this file outside source control, replace every REPLACE_ value, and
# pass it to both Docker Compose and the release preflight. Never commit the
# completed file or paste its contents into logs, tickets, or chat.
#
# Generate values with:
#   ADMIN_PASSWORD, POSTGRES_PASSWORD, JWT_SECRET, SENTRY_TOKEN_PEPPER,
#   SENTRY_PUBSUB_HMAC_KEY, REDIS_PASSWORD:
#     openssl rand -hex 32
#   SENTRY_ENCRYPTION_KEY:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

POSTGRES_USER=sentry_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
POSTGRES_DB=sentry
ADMIN_PASSWORD=REPLACE_WITH_STRONG_INITIAL_ADMIN_PASSWORD

JWT_SECRET=REPLACE
SENTRY_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
SENTRY_TOKEN_PEPPER=REPLACE
SENTRY_PUBSUB_HMAC_KEY=REPLACE
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

TRUST_PROXY=true
API_BIND_HOST=127.0.0.1
ADMIN_BIND_HOST=127.0.0.1
CORS_ORIGINS=https://wms-admin.example.com

# Local OCR is the default and sends no image outside the API host.
SHIPYARD_OCR_PROVIDER=rapidocr
# Optional. Set to baidu only after privacy and cloud-cost approval, then
# provide both Baidu credentials below.
SHIPYARD_OCR_FALLBACK_PROVIDER=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
SHIPYARD_OCR_REQUIRED_FIELDS=material_code,item_name,tag_suffix
SHIPYARD_OCR_TOKEN_TIMEOUT_S=10
SHIPYARD_OCR_TIMEOUT_S=20

SENTRY_INBOUND_SOURCE_PAYLOAD_RETENTION_DAYS=90
SENTRY_INBOUND_MAX_BODY_KB=256

SENTRY_OPS_ENVIRONMENT=production
SENTRY_OPS_ALERT_WEBHOOK_URL=https://alerts.example.com/sentry-wms
SENTRY_OPS_ALERT_BEARER_TOKEN=
SENTRY_OPS_ALLOW_HTTP_ALERTS=false
SENTRY_OPS_INTERVAL_S=60
SENTRY_OPS_TIMEOUT_S=5
SENTRY_OPS_FAILURE_THRESHOLD=2
SENTRY_OPS_REPEAT_S=3600
SENTRY_OPS_BACKUP_MAX_AGE_HOURS=30

SENTRY_BACKUP_SCHEDULE_UTC=02:30
SENTRY_BACKUP_RETENTION_COUNT=14
SENTRY_BACKUP_TIMEOUT_S=1800
SENTRY_BACKUP_RETRY_S=900
SENTRY_BACKUP_RUN_ON_START=true
